{
  "name": "llm-browser",
  "version": "0.1.0",
  "description": "Navegador Electron que un LLM (Claude, Antigravity, ...) puede ver y controlar vía MCP",
  "main": "src/main.js",
  "bin": {
    "llm-browser-mcp": "src/mcp.js"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "local.llmbrowser",
    "productName": "LLM Browser",
    "files": [
      "src/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  }
}
